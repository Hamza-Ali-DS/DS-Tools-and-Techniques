      "age: Skewness = -0.00, Kurtosis = -1.18\n",
      "hours_per_week: Skewness = 2.73, Kurtosis = 23.47\n",
      "capital_gain: Skewness = -0.04, Kurtosis = -1.18\n",
      "capital_loss: Skewness = 0.02, Kurtosis = -1.23\n",
      "annual_income: Skewness = 16.03, Kurtosis = 307.05\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
