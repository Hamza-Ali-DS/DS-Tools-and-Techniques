      "experience_years: Skewness = 0.01, Kurtosis = -1.19\n",
      "bmi: Skewness = 9.05, Kurtosis = 138.08\n",
      "credit_score: Skewness = -0.06, Kurtosis = -1.20\n"
     ]
    }
   ],
   "source": [
    "print(\"--- Statistical Summary ---\")\n",
    "for col in num_cols:\n",
    "    # Drop missing values to prevent math errors during calculation\n",
    "    clean_col = df[col].dropna() \n",
    "    \n",
    "    # Calculate Skewness and Kurtosis\n",
    "    sk = skew(clean_col)\n",
    "    ku = kurtosis(clean_col)\n",
    "    print(f\"{col}: Skewness = {sk:.2f}, Kurtosis = {ku:.2f}\")"
   ]
  },
  {
