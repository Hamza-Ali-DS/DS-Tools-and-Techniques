   "source": [
    "# Force 'annual_income' and 'credit_score' to numeric, turning text/typos into NaN (Not a Number)\n",
    "df['annual_income'] = pd.to_numeric(df['annual_income'], errors='coerce')\n",
    "df['credit_score'] = pd.to_numeric(df['credit_score'], errors='coerce')\n",
    "\n",
    "# Define the continuous numerical columns we want to analyze\n",
    "num_cols = ['age', 'hours_per_week', 'capital_gain', 'capital_loss', \n",
    "            'annual_income', 'experience_years', 'bmi', 'credit_score']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "a80d1611",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
