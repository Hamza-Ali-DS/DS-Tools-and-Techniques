   ],
   "source": [
    "# 1. Detect missing values across the entire dataset\n",
    "print(\"Missing values in each column:\")\n",
    "missing_data = df.isnull().sum()\n",
    "\n",
    "# Only show columns that actually have missing data (greater than 0)\n",
    "print(missing_data[missing_data > 0])\n",
    "\n",
    "# 2. Visualize the missing data \n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.heatmap(df.isnull(), cbar=False, cmap='viridis')\n",
    "plt.title(\"Heatmap of Missing Values (Yellow lines = Missing Data)\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7a87795a",
   "metadata": {},
   "source": [
    "Handle the Missing Values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "0816ebbc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filled missing values in 'annual_income' with median: 69992.5\n",
      "Filled missing values in 'bmi' with median: 27.1\n",
      "Filled missing values in 'credit_score' with median: 589.0\n",
      "Filled missing values in 'workclass' with mode: 'Unemployed'\n",
      "Filled missing values in 'occupation' with mode: 'Sales'\n",
      "Filled missing values in 'native_country' with mode: 'UK'\n",
      "\n",
      "Total missing values remaining: 0\n"
     ]
    }
   ],
   "source": [
    "# 1. Handle Continuous Numerical Columns (Fill with Median)\n",
    "# We use 'median' instead of 'mean' (average) because the median is not ruined by extreme outliers.\n",
    "for col in num_cols:\n",
    "    if df[col].isnull().sum() > 0:\n",
    "        col_median = df[col].median()\n",
    "        df[col] = df[col].fillna(col_median)\n",
    "        print(f\"Filled missing values in '{col}' with median: {col_median}\")\n",
    "\n",
    "# 2. Handle Categorical / Text Columns (Fill with Mode)\n",
    "# For text columns (like gender, occupation), we fill blanks with the most frequent category (the Mode).\n",
    "text_cols = df.select_dtypes(include=['object']).columns\n",
    "for col in text_cols:\n",
    "    if df[col].isnull().sum() > 0:\n",
    "        # mode()[0] gets the most common text value\n",
    "        col_mode = df[col].mode()[0] \n",
    "        df[col] = df[col].fillna(col_mode)\n",
    "        print(f\"Filled missing values in '{col}' with mode: '{col_mode}'\")\n",
    "\n",
    "# 3. Final Verification\n",
    "print(\"\\nTotal missing values remaining:\", df.isnull().sum().sum())"
   ]
  },
