   "source": [
    "# Create empty lists to hold our combined data\n",
    "x_train_list = [] # This will hold the image pixels\n",
    "y_train_list = [] # This will hold the labels (the category numbers)\n",
    "\n",
    "# Loop through numbers 1 to 5 to read data_batch_1 through data_batch_5\n",
    "for i in range(1, 6):\n",
    "    # Construct the full file path for the current batch\n",
    "    batch_file = os.path.join(dataset_dir, f\"data_batch_{i}\")\n",
    "    \n",
    "    # Read the batch using our helper function from Cell 1\n",
    "    batch_dict = unpickle(batch_file)\n",
    "    \n",
    "    # Add the images and labels to our lists\n",
    "    x_train_list.append(batch_dict[b'data'])\n",
    "    y_train_list += batch_dict[b'labels']\n",
    "\n",
    "# Combine the 5 lists into one massive numpy array\n",
    "x_train_raw = np.vstack(x_train_list)\n",
    "\n",
    "# Reshape the raw data into actual images:\n",
    "# -1 means \"figure out the total number of images\" (it will be 50,000)\n",
    "# 3 is the color channels (Red, Green, Blue)\n",
    "# 32, 32 are the width and height of the image\n",
    "# .transpose(0, 2, 3, 1) shifts the color channels to the end, which matplotlib needs to draw it\n",
    "x_train = x_train_raw.reshape(-1, 3, 32, 32).transpose(0, 2, 3, 1)\n",
    "\n",
    "# Convert the label list into a numpy array as well\n",
    "y_train = np.array(y_train_list)\n",
    "\n",
    "print(f\"Successfully loaded {len(x_train)} images. Shape: {x_train.shape}\")"
   ]
  },
