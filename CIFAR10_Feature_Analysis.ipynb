   "source": [
    "# Create a large grid for our plots: 3 rows (for 3 classes) and 3 columns (for 3 tasks)\n",
    "fig, axes = plt.subplots(nrows=3, ncols=3, figsize=(15, 12))\n",
    "fig.suptitle(\"Task 2: CIFAR-10 Feature Extraction & Analysis\", fontsize=16)\n",
    "\n",
    "# Loop through each of our selected classes (Airplane, Auto, Cat)\n",
    "for i, cls_idx in enumerate(selected_classes):\n",
    "    \n",
    "    # 1. Filter out only the images that belong to the current class\n",
    "    class_images = x_train[y_train == cls_idx]\n",
    "    class_name = class_names[cls_idx].capitalize()\n",
    "    \n",
    "    # Pick a random number between 0 and 5000 to select a random image\n",
    "    random_index = np.random.randint(0, len(class_images))\n",
    "    sample_img = class_images[random_index]\n",
    "    \n",
    "    \n",
    "    # --- COLUMN 1: Visualize a Random Sample ---\n",
    "    axes[i, 0].imshow(sample_img) # Show the image\n",
    "    axes[i, 0].set_title(f\"Sample: {class_name}\")\n",
    "    axes[i, 0].axis('off') # Hide the gridlines on the image\n",
    "    \n",
    "    \n",
    "    # --- COLUMN 2: Pixel Intensity Histogram (For the single sample image) ---\n",
    "    colors = ('red', 'green', 'blue')\n",
    "    for channel_idx, color in enumerate(colors):\n",
    "        # Calculate how many pixels have each intensity value (0 to 255) for R, G, and B\n",
    "        histogram, bin_edges = np.histogram(sample_img[:, :, channel_idx], bins=256, range=(0, 256))\n",
    "        # Draw the line on the chart\n",
    "        axes[i, 1].plot(bin_edges[0:-1], histogram, color=color[0], alpha=0.7)\n",
    "        \n",
    "    axes[i, 1].set_title(f\"{class_name} - Single Image Pixel Intensity\")\n",
    "    axes[i, 1].set_xlim([0, 256]) # Limit X axis to valid pixel values\n",
    "    if i == 2: axes[i, 1].set_xlabel(\"Pixel Value (0-255) -> Dark to Light\")\n",
    "        \n",
    "        \n",
    "    # --- COLUMN 3: Mean RGB Distribution (For ALL 5000 images in the class) ---\n",
    "    # Calculate the average color of every single image in this class\n",
    "    # axis=(1, 2) means we average across the width and height, leaving just the 3 RGB averages per image\n",
    "    mean_rgb = np.mean(class_images, axis=(1, 2)) \n",
    "    \n",
    "    for channel_idx, color in enumerate(colors):\n",
    "        # Plot a histogram showing the distribution of these average colors\n",
    "        axes[i, 2].hist(mean_rgb[:, channel_idx], bins=50, color=color[0], alpha=0.5, label=color.upper())\n",
    "        \n",
    "    axes[i, 2].set_title(f\"{class_name} - Mean RGB Distribution (All Images)\")\n",
    "    if i == 0: axes[i, 2].legend() # Show the Red/Green/Blue legend on the top right chart\n",
    "    if i == 2: axes[i, 2].set_xlabel(\"Average Pixel Value\")\n",
    "\n",
    "# Adjust spacing so titles and charts don't overlap\n",
    "plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n",
    "plt.show() # Display the final dashboard"
   ]
  }
