    "# Import necessary libraries\n",
    "import pickle      # Used to read the specific 'pickled' format of the CIFAR-10 files\n",
    "import numpy as np # Used for matrix and array calculations (handling the image pixels)\n",
    "import matplotlib.pyplot as plt # Used to draw the graphs and display images\n",
    "import os          # Used to handle file paths safely\n",
    "\n",
    "# Define the exact folder path where your CIFAR-10 files are saved\n",
    "# The 'r' before the string tells Python to read the backslashes exactly as they are\n",
    "dataset_dir = r\"C:\\Users\\HAMZA ALI\\Desktop\\Fast Nuces MSDS\\DS Tools and Techniques\\Assignment\\2\\cifar-10-python\\cifar-10-batches-py\"\n",
    "\n",
    "# Create a helper function to open and read the downloaded files\n",
    "def unpickle(file):\n",
    "    with open(file, 'rb') as fo: # 'rb' means read binary\n",
    "        # encoding='bytes' ensures Python 3 reads the older Python 2 format correctly\n",
    "        data_dict = pickle.load(fo, encoding='bytes') \n",
    "    return data_dict"
   ]
  },
  {
