    "# Based on the CIFAR-10 class list, we select the indexes for:\n",
    "# Airplane (0), Automobile (1), Cat (3)\n",
    "selected_classes = [0, 1, 3]\n",
    "\n",
    "print(\"Selected classes for analysis:\")\n",
    "for cls_idx in selected_classes:\n",
    "    print(f\"- {class_names[cls_idx].capitalize()}\")"
