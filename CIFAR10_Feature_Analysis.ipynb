    "# Locate the metadata file\n",
    "meta_file = os.path.join(dataset_dir, \"batches.meta\")\n",
    "\n",
    "# Read the metadata file\n",
    "meta_dict = unpickle(meta_file)\n",
    "\n",
    "# Extract the names. They are stored as byte strings (like b'airplane'), \n",
    "# so we decode them into normal text strings using UTF-8.\n",
    "class_names = [label.decode('utf-8') for label in meta_dict[b'label_names']]\n",
    "\n",
    "print(f\"Classes found: {class_names}\")"
   ]
